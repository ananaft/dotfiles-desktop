{
	"clock": {
		"locale": "en_GB.UTF-8",
		"format": "{:%H:%M}",
		"interval": 30,
		"timezone": "Europe/Vienna"
	},
	"clock#screen1": {
		"tooltip-format": "<tt><span size='12pt' font='BitStromWera Nerd Font'>{calendar}</span></tt>",
		"calendar": {
			"mode"          : "year",
            "mode-mon-col"  : 4,
			"weeks-pos"     : "right",
			"on-scroll"     : 1,
			"format": {
				"months":     "<span color='#c7849d'><b>{}</b></span>",
				"days":       "<span color='#78A65A'><b>{}</b></span>",
				"weeks":      "<span color='#2c6d37'><b>W{}</b></span>",
				"weekdays":   "<span color='#C58B5F'><b>{}</b></span>",
				"today":      "<span color='#c57277'><b><u>{}</u></b></span>"
			}
		},
		"actions":  {
			"on-click": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
        }
	},
	"clock#screen2": {
		"tooltip-format": "<tt><span size='12pt' font='BitStromWera Nerd Font'>{calendar}</span></tt>",
		"calendar": {
			"mode": "month",
			"format": {
				"months":     "<span color='#cbd4c1'><b>{}</b></span>",
				"days":       "<span color='#003f74'><b>{}</b></span>",
				"weeks":      "<span color='#257697'><b>W{}</b></span>",
				"weekdays":   "<span color='#93b2bb'><b>{}</b></span>",
				"today":      "<span color='#cbd4c1'><b><u>{}</u></b></span>"
			}
		},
		"actions":  {
			"on-click": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
        }
	},
	"clock#screen3": {
		"tooltip-format": "<tt><span size='12pt' font='BitStromWera Nerd Font'>{calendar}</span></tt>",
		"calendar": {
			"mode": "month",
			"format": {
				"months":     "<span color='#c7849d'><b>{}</b></span>",
				"days":       "<span color='#78A65A'><b>{}</b></span>",
				"weeks":      "<span color='#2c6d37'><b>W{}</b></span>",
				"weekdays":   "<span color='#C58B5F'><b>{}</b></span>",
				"today":      "<span color='#c57277'><b><u>{}</u></b></span>"
			}
		},
		"actions":  {
			"on-click": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
        }
	},
	"custom/cpu_temp": {
		"exec": "~/.config/waybar/scripts/cpu_temp.sh",
		"format": "<span font-family='Font Awesome 7 Pro Light'>\uf2db</span>:{}",
		"interval": 1,
		"tooltip": false
	},
	"custom/gpu_temp": {
		"exec": "~/.config/waybar/scripts/gpu_temp.sh",
		"format": "<span font-family='Font Awesome 7 Pro Light'>\ue843</span>:{}",
		"interval": 1,
		"tooltip": false
	},
	"custom/power": {
		"format": "\uf011",
		"tooltip": false,
		"on-click": "~/.config/waybar/scripts/powermenu.sh"
	},
	"memory": {
		"format": "<span font-family='Font Awesome 7 Pro Regular'>\uf538</span>:{used:0.1f}G/{total:0.1f}G",
		"tooltip": false
	},
	"cpu": {
		"interval": 3,
		"format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
		"format-icons": [
			"<span color='#cbd4c1'>\u2581</span>",
			"<span color='#cbd4c1'>\u2582</span>",
			"<span color='#cbd4c1'>\u2583</span>",
          	"<span color='#cbd4c1'>\u2584</span>",
          	"<span color='#cbd4c1'>\u2585</span>",
          	"<span color='#cbd4c1'>\u2586</span>",
          	"<span color='#cbd4c1'>\u2587</span>",
          	"<span color='#cbd4c1'>\u2588</span>"
		],
		"tooltip": false
	},
	"wireplumber#sink": {
		"node-type": "Audio/Sink",
		"format": "{icon} :{volume}%",
		"format-icons": ["\uf027", "\uf028"],
		"format-muted": "<span font-family='Font Awesome 7 Free Solid'>\uf6a9</span>",
		"on-click": "~/.config/waybar/scripts/change_volume.sh -v 20 -t sink",
		"on-click-right": "~/.config/waybar/scripts/change_volume.sh -v -20 -t sink",
		"on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	},
	"wireplumber#source": {
		"node-type": "Audio/Source",
		"format": "{icon}:{volume}%",
		"format-icons": ["\uf130"],
		"format-muted": "\uf131 ",
		"on-click": "~/.config/waybar/scripts/change_volume.sh -v 20 -t source",
		"on-click-right": "~/.config/waybar/scripts/change_volume.sh -v -20 -t source",
		"on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
	},
	"tray": {
		"spacing": 2
	},
	"hyprland/workspaces": {
		"format": "{icon}: {windows}",
		"format-window-separator": "",
		"workspace-taskbar": {
			"enable": true,
			"update-active-window": true,
			"format": "{icon} {title:.20}",
			"icon-size": 12
		}
	},
	"hyprland/workspaces#screen1": {
		"format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三"
        }
	},
	"hyprland/workspaces#screen2": {
		"format": "{icon}",
        "format-icons": {
            "4": "四",
            "5": "五",
			"6": "六"
        }
	},
	"hyprland/workspaces#screen3": {
		"format": "{icon}",
        "format-icons": {
            "7": "七",
            "8": "八",
			"9": "九"
        }
	},
	"hyprland/window": {
		"format": "{initialClass} {title}",
		"separate-outputs": true,
		"rewrite": {
			"^Alacritty\\s(.*)$": "<span font-family='Font Awesome 7 Pro Solid'>\ue236</span>",
			"^firefox\\s(.*?)( — Mozilla Firefox|Mozilla Firefox)?$": "<span font-family='Font Awesome 7 Brands'>\ue007</span> $1",
			"^org.pwmt.zathura\\s.*\\/(.*)\\..*$": "<span font-family='Font Awesome 7 Pro Regular'>\ue130</span> $1",
			"^guitarpro\\.exe\\s(.*?)( - Guitar Pro 8|Guitar Pro 8)?$": "<span font-family='Font Awesome 7 Pro Solid'>\uf8c9</span> $1",
			"^Ardour\\s(.*?)( - Ardour|Ardour)?$": "<span font-family='Font Awesome 7 Pro Solid'>\uf3f1</span> $1"
		},
		"tooltip": false
	},
	"hyprland/language": {
		"format": {},
		"format-en": "EN",
		"format-de": "DE",
		"on-click": "hyprctl switchxkblayout rdr-crush-80 next",
		"tooltip": false
	}
}
