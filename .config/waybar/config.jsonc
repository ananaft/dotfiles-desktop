// -*- mode: jsonc -*-
[{
	"layer": "top",
	"output": "DP-1",
	"height": 36,
	"spacing": 5,
	"include": [
		"~/.config/waybar/default-modules.json"
	],
	"modules-left": [
		"clock#screen1",
		"hyprland/window",
        "hyprland/submap"
	],
	"modules-center": [
		"hyprland/workspaces#screen1"
    ],
	"modules-right": [
		"hyprland/language",
		"wireplumber#sink",
		"wireplumber#source",
		"tray",
		"custom/power"
	]
}, {
	"layer": "top",
	"output": "HDMI-A-1",
	"height": 36,
	"spacing": 5,
	"include": [
		"~/.config/waybar/default-modules.json"
	],
	"modules-left": [
		"clock#screen2",
		"hyprland/window",
        "hyprland/submap"
	],
	"modules-center": [
		"hyprland/workspaces#screen2"
    ],
	"modules-right": [
		"custom/cpu_temp",
		"custom/gpu_temp",
		"cpu",
		"memory",
		"hyprland/language",
		"wireplumber#sink",
		"wireplumber#source",
		"tray",
		"custom/power"
	]
}]
